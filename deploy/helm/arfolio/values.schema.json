{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["app"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "app": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^(https?://.+)?$"},
        "brandName": {"type": "string", "minLength": 1},
        "brandPrimaryColor": {"type": "string"},
        "brandLogoUrl": {"type": "string"},
        "defaultLocale": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "clientIpHeader": {"type": "string", "minLength": 1}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "generate": {"type": "boolean"},
        "existingSecret": {"type": "string"}
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "service": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "healthPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "persistence": {
          "type": "object",
          "properties": {
            "size": {"type": "string", "minLength": 1},
            "storageClass": {"type": "string"},
            "existingClaim": {"type": "string"}
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "string", "minLength": 1},
        "ownerUser": {"type": "string", "minLength": 1},
        "appUser": {"type": "string", "minLength": 1},
        "existingSecret": {"type": "string"},
        "ownerPasswordKey": {"type": "string", "minLength": 1},
        "sslmode": {"type": "string", "enum": ["", "disable", "allow", "prefer", "require", "verify-ca", "verify-full"]}
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "repositorySuffix": {"type": "string"},
        "resticPasswordFromBackupSecret": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string"},
        "keep": {
          "type": "object",
          "properties": {
            "daily": {"type": "integer", "minimum": 0},
            "weekly": {"type": "integer", "minimum": 0},
            "monthly": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {"type": "array", "items": {"type": "object", "required": ["host"]}},
        "tls": {"type": "array", "items": {"type": "object"}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "podAnnotations": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}

# Arfolio configuration for the Docker Compose install (compose.yaml).
# Run ./scripts/init-env.sh to create .env from this file with fresh random secrets.
# Integrations (Anthropic, Enable Banking, SMTP) are set from the app: Settings -> Services.

# --- Bootstrap (required) ---

# Postgres owner password. Used by `migrate` (as owner) and by the bundled database.
POSTGRES_PASSWORD=
# Password of the unprivileged pfm_app role that web and worker connect as (migrate sets it).
APP_DB_PASSWORD=
# 32+ characters; signs sessions. Back it up like ENCRYPTION_KEY: changing it invalidates 2FA enrolments,
# backup codes and MCP OAuth signing keys (and signs everybody out).
BETTER_AUTH_SECRET=
# Guards first-run setup at /setup: you enter it once to create the first account (24+ characters).
SETUP_TOKEN=
# Public URL of the app. Behind a reverse proxy this MUST be the public https URL
# (for example https://arfolio.example.com), or sign-in and bank callbacks fail.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# 32 random bytes as 64 hex characters: openssl rand -hex 32
# BACK THIS KEY UP with your database backups. It encrypts every stored bank session and Trading 212
# key; if it is lost or replaced, all connections must be re-authorised (imported data is unaffected).
# It also encrypts the generated VAPID private key: after replacing it, push sending fails with a
# decrypt error until you delete the stored pair (delete from instance_secret where name = 'vapid')
# or set VAPID_*; a new pair means every device must re-subscribe to push.
ENCRYPTION_KEY=


# --- Optional: overrides the Services page ---
# Everything below is configured from Settings -> Services in the app. A variable set here takes
# precedence over the value stored from the UI. Uncomment to use.

# Bank connections (Enable Banking). Register APP_URL/api/connections/callback as the redirect URL.
# Setup guide: docs/bank-sync.md. The private key is a PEM (real newlines or \n escaped).
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_PRIVATE_KEY=
# ENABLE_BANKING_API_URL=https://api.enablebanking.com

# AI categorisation (households still opt in).
# ANTHROPIC_API_KEY=
# AI_CATEGORISATION_MODEL=claude-haiku-5-5
# AI_REPORT_MODEL=claude-opus-5-5
# AI_VALUATION_MODEL=claude-opus-5-5
# Merchant logos: the worker fetches each merchant's favicon through Google's favicon service
# (which learns the merchant's domain, never your transactions). Set to off to disable.
# MERCHANT_LOGOS=on

# Web Push (VAPID). Optional: when unset the app generates a key pair on first use and stores it
# (the private key encrypted with ENCRYPTION_KEY) in the database. To pin your own, set BOTH keys
# (setting only one is a startup error): npx web-push generate-vapid-keys
# Subject is a mailto: or https: contact for push services; defaults to an https APP_URL, else
# mailto:no-reply@localhost (the worker reads APP_URL too, so set it there for a real contact).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Push subscriptions are accepted only for the browser push services (FCM, Mozilla, Windows, Apple).
# Self-hosted push (e.g. UnifiedPush): extra host suffixes, comma separated (subdomains included).
# PUSH_ALLOWED_HOSTS=push.example.org

# MCP (Claude connector and Claude Code). The OAuth server accepts the claude.ai / claude.com
# callbacks and loopback http://localhost:<port>/callback by default. Optional: extra exact redirect
# URIs for other MCP clients, comma separated (absolute URIs, no fragment).
# MCP_ALLOWED_REDIRECT_URIS=https://client.example.org/oauth/callback

# Email (invitations only; there is no password-reset email). Web only; nothing is sent when SMTP_URL is unset.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Arfolio <no-reply@example.com>

# Look and behaviour. Unset keeps the default.
# BRAND_NAME=Arfolio
# BRAND_PRIMARY_COLOR="#2F5BC2"
# BRAND_LOGO_URL=https://example.org/logo.svg
# en or pt-PT
# DEFAULT_LOCALE=en
# Header your reverse proxy sets (overwriting it) to the real client address.
# CLIENT_IP_HEADER=x-real-ip
# Time zone of the worker's schedules.
# TZ=UTC

# TEST ONLY: points Trading 212 at a fake broker. Leave unset in real deployments (the key only
# works on the live API). In production it must be https, except for loopback hosts.
# TRADING212_API_URL=http://127.0.0.1:4000/api/v0

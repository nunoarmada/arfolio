{
  "name": "arfolio",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.7.0",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:seed": "pnpm --filter @arfolio/web exec tsx --tsconfig ../../packages/services/tsconfig.json ../../scripts/demo-seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
